# Fish Speech
# RTX 50xx (Blackwell): local image built by bootstrap (S1-mini + CUDA 12.9)
# Other GPUs: fishaudio/fish-speech:webui-cuda and server-cuda
FISH_SPEECH_WEBUI_IMAGE=zeiron/fish-speech:webui-s1-cu129
FISH_SPEECH_API_IMAGE=zeiron/fish-speech:server-s1-cu129
COMPILE=1
GRADIO_PORT=7860
API_PORT=8080
LLAMA_CHECKPOINT_PATH=checkpoints/openaudio-s1-mini
DECODER_CHECKPOINT_PATH=checkpoints/openaudio-s1-mini/codec.pth

# XTTS comparison (docker-compose.xtts.yml)
XTTS_PORT=5002

# Voice profile id used by test scripts (references/<id>/)
VOICE_ID=voice_a
